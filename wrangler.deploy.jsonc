{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bb-malin-iceberg",
  "workers_dev": true,
  "preview_urls": false,
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bb-malin-iceberg-db",
      "database_id": "bcc4b7f0-f71e-47ea-9c8e-fdf4a3e80858",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
